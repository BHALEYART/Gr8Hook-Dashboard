# Copy to .env.local for local dev, and add the same values in Vercel → Settings → Environment Variables.
# Leave the Supabase values empty to run in demo mode with sample data.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Protects /api/cron/sync (Vercel Cron sends it automatically when set in Vercel)
CRON_SECRET=

# Google Ads API (Google Cloud project with the Google Ads API enabled + an OAuth client; e.g. v26)
GOOGLE_ADS_API_VERSION=
# Optional now: access comes from the Cloud project. Leave blank unless you already have one.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Meta Marketing API (Business Manager System User token with ads_read)
META_API_VERSION=
META_ACCESS_TOKEN=

# GoHighLevel workflow webhook shared secret
GHL_WEBHOOK_SECRET=
