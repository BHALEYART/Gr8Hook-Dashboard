# Copy to .env.local for local dev, and add the same values in Vercel → Settings → Environment Variables.
# Leave the Supabase values empty to run in demo mode with sample data.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Protects /api/cron/sync (Vercel Cron sends it automatically when set in Vercel)
CRON_SECRET=

# Google Ads API (Google Cloud project with the Google Ads API enabled + an OAuth client; e.g. v26)
GOOGLE_ADS_API_VERSION=
# Optional now: access comes from the Cloud project. Leave blank unless you already have one.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Meta Marketing API (Business Manager System User token with ads_read)
META_API_VERSION=
META_ACCESS_TOKEN=
# "Connect Facebook" button (Meta app → App settings → Basic). Optional: a Facebook Login for Business config ID.
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=

# GoHighLevel workflow webhook shared secret
GHL_WEBHOOK_SECRET=

# Free website audit for gr8hook.com/audit (/api/site-audit). Google Cloud → APIs & Services: enable
# "PageSpeed Insights API", create an API key restricted to that API. Works without a key, but with a low shared quota.
PAGESPEED_API_KEY=
# Optional: comma-separated sites allowed to call the audit endpoint (default: https://gr8hook.com,https://www.gr8hook.com)
AUDIT_ALLOWED_ORIGINS=

# Audit leads: "Get my full report" on gr8hook.com/audit (/api/audit-lead)
# Resend (resend.com) sends the report to the prospect and alerts you. Verify gr8hook.com in Resend first.
RESEND_API_KEY=
AUDIT_FROM_EMAIL=Gr8 Hook <reports@gr8hook.com>
AUDIT_REPLY_TO=Sales@Gr8Hook.com
# Who gets lead alerts (comma-separated). Hot leads always alert; set AUDIT_NOTIFY_ALL=true to be told about every lead.
AUDIT_NOTIFY_EMAIL=Admin@gr8hook.com
AUDIT_NOTIFY_ALL=
# Signs audit results so report requests can't be faked. Any long random string (falls back to PAGESPEED_API_KEY).
AUDIT_SECRET=
# Mailing address shown in the report email footer (required in marketing email by CAN-SPAM; a PO box works)
MAIL_POSTAL_ADDRESS=
